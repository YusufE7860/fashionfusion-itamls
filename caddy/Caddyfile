{
	# Auto-HTTPS off — we're serving a purchased cert instead
	auto_https off
}

# ---- HTTPS :WEB_PORT (default 41235) ----
# Serves the ITAMLS app with the imported cert at /etc/caddy/certs/.
# No port 80 needed externally — no ACME challenges, no auto-renewal.
# When the cert expires you drop new files into /opt/itamls/caddy/certs
# and `docker restart itamls_caddy`.
{$APP_FQDN}:{$WEB_PORT} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

	# Big uploads go to MinIO via /minio/*, so lift the body limit site-wide.
	# API endpoints that accept files have their own validation anyway.
	request_body {
		max_size 500MB
	}

	# --- API traffic goes to the Nest container ---
	handle /api/* {
		reverse_proxy api:4000 {
			transport http {
				read_timeout  120s
				write_timeout 120s
			}
		}
	}

	# --- Everything else goes to the SPA served by the web container ---
	handle {
		reverse_proxy web:80
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options            "SAMEORIGIN"
		X-Content-Type-Options     "nosniff"
		Referrer-Policy            "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ---- HTTPS :MINIO_PUBLIC_PORT (default 41236) ----
# Dedicated TLS endpoint for MinIO so the browser hits presigned URLs on a
# clean host:port that matches what the SDK signed for. Keeps SigV4 safe —
# no path rewriting, no host rewriting, no surprises.
{$APP_FQDN}:{$MINIO_PUBLIC_PORT} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

	request_body {
		max_size 500MB
	}

	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header {
			Access-Control-Allow-Origin  "https://{$APP_FQDN}:{$WEB_PORT}"
			Access-Control-Allow-Methods "GET, PUT, POST, HEAD, DELETE, OPTIONS"
			Access-Control-Allow-Headers "*"
			Access-Control-Max-Age       "86400"
		}
		respond 204
	}
	handle {
		reverse_proxy minio:9000 {
			# Preserve the original Host header so MinIO's SigV4 check sees
			# "it.ffgsa.co.za:41236" (what the SDK signed with), not
			# "minio:9000" (Caddy's default dial-address rewrite).
			header_up Host {host}
			transport http {
				read_timeout  10m
				write_timeout 10m
			}
			# Strip MinIO's own CORS headers; our single clean set added below.
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down -Vary
		}
		header {
			Access-Control-Allow-Origin   "https://{$APP_FQDN}:{$WEB_PORT}"
			Access-Control-Expose-Headers "ETag"
			Vary "Origin"
		}
	}

	log {
		output stdout
		format console
	}
}
