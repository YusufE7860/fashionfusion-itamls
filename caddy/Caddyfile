{
	# Auto-HTTPS off — we're serving a purchased cert instead
	auto_https off
}

# ---- HTTPS :WEB_PORT (default 41235) ----
# Serves the ITAMLS app with the imported cert at /etc/caddy/certs/.
# No port 80 needed externally — no ACME challenges, no auto-renewal.
# When the cert expires you drop new files into /opt/itamls/caddy/certs
# and `docker restart itamls_caddy`.
{$APP_FQDN}:{$WEB_PORT} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

	# Allow 32 MB uploads (invoices, decommission certs, backup manifests, etc)
	request_body {
		max_size 32MB
	}

	# --- API traffic goes to the Nest container ---
	handle /api/* {
		reverse_proxy api:4000 {
			transport http {
				read_timeout  120s
				write_timeout 120s
			}
		}
	}

	# --- Everything else goes to the SPA served by the web container ---
	handle {
		reverse_proxy web:80
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options            "SAMEORIGIN"
		X-Content-Type-Options     "nosniff"
		Referrer-Policy            "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# ---- HTTPS :MINIO_PUBLIC_PORT (default 41236) ----
# Public TLS endpoint for MinIO so the browser can hit presigned URLs over
# HTTPS. The API server points the "public" MinIO client at this URL when
# generating presigned links, so the signature matches what the browser
# actually requests.
{$APP_FQDN}:{$MINIO_PUBLIC_PORT} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

	# MinIO can accept large uploads; let presigned PUTs go through.
	request_body {
		max_size 500MB
	}

	# CORS — the main app is on :41235 and uploads here on :41236; different
	# port = different origin, so the browser requires these headers.
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header {
			Access-Control-Allow-Origin  "https://{$APP_FQDN}:{$WEB_PORT}"
			Access-Control-Allow-Methods "GET, PUT, POST, HEAD, DELETE, OPTIONS"
			Access-Control-Allow-Headers "*"
			Access-Control-Max-Age       "86400"
		}
		respond 204
	}

	handle {
		header {
			Access-Control-Allow-Origin  "https://{$APP_FQDN}:{$WEB_PORT}"
			Access-Control-Expose-Headers "ETag"
		}
		reverse_proxy minio:9000 {
			transport http {
				read_timeout  10m
				write_timeout 10m
			}
		}
	}

	log {
		output stdout
		format console
	}
}
