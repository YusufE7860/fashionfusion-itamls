{
	# Auto-HTTPS off — we're serving a purchased cert instead
	auto_https off
}

# ---- HTTPS :WEB_PORT (default 41235) ----
# Serves the ITAMLS app with the imported cert at /etc/caddy/certs/.
# No port 80 needed externally — no ACME challenges, no auto-renewal.
# When the cert expires you drop new files into /opt/itamls/caddy/certs
# and `docker restart itamls_caddy`.
{$APP_FQDN}:{$WEB_PORT} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

	# Allow 32 MB uploads (invoices, decommission certs, backup manifests, etc)
	request_body {
		max_size 32MB
	}

	# --- API traffic goes to the Nest container ---
	handle /api/* {
		reverse_proxy api:4000 {
			transport http {
				read_timeout  120s
				write_timeout 120s
			}
		}
	}

	# --- Everything else goes to the SPA served by the web container ---
	handle {
		reverse_proxy web:80
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options            "SAMEORIGIN"
		X-Content-Type-Options     "nosniff"
		Referrer-Policy            "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
