// Prisma schema for Fashion Fusion ITAMLS

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev on Windows/Mac/Linux glibc,
  // "linux-musl-openssl-3.0.x" for Alpine-based Docker images.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------
model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id      String           @id @default(cuid())
  code    String           @unique
  description String?
  roles   RolePermission[]
  userOverrides UserPermissionOverride[]
}

// Per-user permission overrides on top of the role's defaults.
// effect: GRANT (extra permission beyond role) or DENY (remove from role).
model UserPermissionOverride {
  userId       String
  permissionId String
  effect       String   // GRANT | DENY

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  fullName            String
  passwordHash        String?
  adSid               String?  @unique
  roleId              String
  storeId             String?
  isActive            Boolean  @default(true)
  totpSecret          String?
  totpEnabled         Boolean  @default(false)
  mustChangePassword  Boolean  @default(false)   // forces the change-password modal on next login
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  role  Role   @relation(fields: [roleId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])

  assignedAssets Asset[]        @relation("AssignedUser")
  historyEntries AssetHistory[]
  ibtRequested   Ibt[]          @relation("RequestedBy")
  ibtApproved    Ibt[]          @relation("ApprovedBy")
  ibtDispatched  Ibt[]          @relation("DispatchedBy")
  dispatches     Dispatch[]
  prRequested    PurchaseRequest[] @relation("PrRequester")
  prApproved     PurchaseRequest[] @relation("PrApprover")

  permissionOverrides UserPermissionOverride[]
  storeAccess         UserStoreAccess[]
}

// ---------- Catalog / Master Data ----------
model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  skus      Sku[]
  templateItems StoreTemplateItem[]
}

model Sku {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  categoryId         String
  manufacturer       String
  model              String
  isSerialised       Boolean  @default(true)
  warrantyMonths     Int      @default(12)
  depreciationYears  Int      @default(4)
  reorderLevel       Int      @default(0)
  unitCostCents      Int      @default(0)

  category Category @relation(fields: [categoryId], references: [id])
  assets   Asset[]
  stock    Stock[]
  grvLines GrvLine[]
  prLines  PurchaseRequestLine[]
  ibtLines IbtLine[]
  stockMovements StockMovement[]
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  contactName    String?
  email          String?
  phone          String?
  taxNumber      String?
  paymentTerms   String?
  leadTimeDays   Int?
  isActive       Boolean  @default(true)

  assets    Asset[]
  grvs      Grv[]
  repairs   Repair[]
  invoices  Invoice[]
  pos       PurchaseOrder[]
  softwareLicenses SoftwareLicense[]
}

// ---------- Locations & Stores ----------
model Location {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String   // HEAD_OFFICE, STOCK_ROOM, STORE, REPAIR_BAY, IN_TRANSIT
  region    String?
  parentId  String?
  parent    Location? @relation("LocationTree", fields: [parentId], references: [id])
  children  Location[] @relation("LocationTree")

  store     Store?
  assetsHere     Asset[]         @relation("CurrentLocation")
  stock          Stock[]
  ibtFrom        Ibt[]           @relation("IbtFrom")
  ibtTo          Ibt[]           @relation("IbtTo")
  movementsFrom  StockMovement[] @relation("MovementFrom")
  movementsTo    StockMovement[] @relation("MovementTo")
  historyFrom    AssetHistory[]  @relation("HistoryFrom")
  historyTo      AssetHistory[]  @relation("HistoryTo")
}

model StoreTemplate {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String              // Small, Medium, Large, Flagship
  description String?
  items       StoreTemplateItem[]
  stores      Store[]
}

model StoreTemplateItem {
  id          String        @id @default(cuid())
  templateId  String
  categoryId  String
  requiredQty Int

  template StoreTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id])

  @@unique([templateId, categoryId])
}

model Store {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  region     String
  entity     String   @default("FASHION_FUSION") // FASHION_FUSION | EVLV
  locationId String   @unique
  templateId String?
  openedAt   DateTime?
  status     String   @default("PLANNED")

  location   Location       @relation(fields: [locationId], references: [id])
  template   StoreTemplate? @relation(fields: [templateId], references: [id])

  assignedAssets Asset[]      @relation("AssignedStore")
  users          User[]
  dispatches     Dispatch[]
  audits         Audit[]
  tonerPlans     TonerPlan[]
  tonerOrderLines TonerOrderLine[]
  storePcs       StorePc[]
  backupJob      BackupJob?
  userAccess     UserStoreAccess[]
  dvrs           Dvr[]
}

// ---------- Inventory ----------
model Asset {
  id                String    @id @default(cuid())
  assetTag          String    @unique
  serialNo          String?
  skuId             String
  supplierId        String?
  purchaseDate      DateTime?
  purchaseCostCents Int       @default(0)
  currentValueCents Int       @default(0)
  warrantyExpiry    DateTime?
  condition         String?   // NEW, GOOD, FAIR, POOR
  status            String    @default("IN_STOCK")
  locationId        String?
  assignedUserId    String?
  assignedStoreId   String?
  assignedDepartmentId String?    // for HQ assets: which department owns it
  installedAt       DateTime?

  // Auto-discovery (Kaseya VSA agent)
  hostname          String?
  osVersion         String?
  cpuModel          String?
  ramGb             Int?
  macAddresses      String?   // CSV
  lastSeenAt        DateTime?
  source            String?   // MANUAL | DISCOVERY

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sku         Sku       @relation(fields: [skuId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  location    Location? @relation("CurrentLocation", fields: [locationId], references: [id])
  assignedUser  User?   @relation("AssignedUser", fields: [assignedUserId], references: [id])
  assignedStore Store?  @relation("AssignedStore", fields: [assignedStoreId], references: [id])
  assignedDepartment Department? @relation(fields: [assignedDepartmentId], references: [id])

  history  AssetHistory[]
  repairs  Repair[]
  ibtLines IbtLine[]
}

// ---------- HQ departments ----------
// For head-office assets, this is the "who owns it" dimension in place of a
// store. Editable from the admin UI so new departments can be added without
// a schema change (or the fixed defaults renamed for a merger etc).
model Department {
  id          String   @id @default(cuid())
  code        String   @unique              // short slug: HR, ACC, OPS, IT, MERCH, DIR, WH, MAINT, PLANT
  name        String                          // display name
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets Asset[]
}

model AssetHistory {
  id            String   @id @default(cuid())
  assetId       String
  eventType     String   // PURCHASED, RECEIVED, DISPATCHED, INSTALLED, MOVED, REPAIR_IN, REPAIR_OUT, AUDITED, RETIRED
  fromLocationId String?
  toLocationId   String?
  refTable      String?
  refId         String?
  actorId       String?
  occurredAt    DateTime @default(now())
  notes         String?

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromLoc  Location? @relation("HistoryFrom", fields: [fromLocationId], references: [id])
  toLoc    Location? @relation("HistoryTo", fields: [toLocationId], references: [id])
  actor    User?     @relation(fields: [actorId], references: [id])
}

model Stock {
  id           String @id @default(cuid())
  skuId        String
  locationId   String
  qtyOnHand    Int    @default(0)
  qtyReserved  Int    @default(0)
  reorderLevel Int    @default(0)

  sku      Sku      @relation(fields: [skuId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([skuId, locationId])
}

model StockMovement {
  id              String   @id @default(cuid())
  skuId           String
  fromLocationId  String?
  toLocationId    String?
  qty             Int
  reason          String
  refTable        String?
  refId           String?
  occurredAt      DateTime @default(now())

  sku      Sku       @relation(fields: [skuId], references: [id])
  fromLoc  Location? @relation("MovementFrom", fields: [fromLocationId], references: [id])
  toLoc    Location? @relation("MovementTo", fields: [toLocationId], references: [id])
}

// ---------- Logistics ----------
model Grv {
  id             String   @id @default(cuid())
  code           String   @unique
  supplierId     String
  invoiceNo      String?
  invoiceDate    DateTime?
  deliveryNoteNo String?
  receivedAt     DateTime @default(now())
  receivedById   String?
  totalCents     Int      @default(0)
  status         String   @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  notes          String?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  lines    GrvLine[]
  invoices Invoice[]
}

model GrvLine {
  id              String @id @default(cuid())
  grvId           String
  skuId           String
  qty             Int
  unitCostCents   Int
  serialNumbers   String?  // CSV
  warrantyExpiry  DateTime?

  grv Grv @relation(fields: [grvId], references: [id], onDelete: Cascade)
  sku Sku @relation(fields: [skuId], references: [id])
}

model Ibt {
  id              String   @id @default(cuid())
  code            String   @unique
  fromLocationId  String
  toLocationId    String
  status          String   @default("REQUESTED")
  requestedById   String
  approvedById    String?
  dispatchedById  String?
  courier         String?
  trackingNo      String?
  boxNumbers      String?  // Optional, comma-separated. e.g. "BOX-001, BOX-002"
  sentAt          DateTime?
  receivedAt      DateTime?
  createdAt       DateTime @default(now())
  notes           String?

  fromLoc      Location @relation("IbtFrom", fields: [fromLocationId], references: [id])
  toLoc        Location @relation("IbtTo", fields: [toLocationId], references: [id])
  requestedBy  User     @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  dispatchedBy User?    @relation("DispatchedBy", fields: [dispatchedById], references: [id])

  lines      IbtLine[]
  dispatches Dispatch[]
}

model IbtLine {
  id       String @id @default(cuid())
  ibtId    String
  assetId  String?
  skuId    String
  qty      Int

  ibt   Ibt    @relation(fields: [ibtId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id])
  sku   Sku    @relation(fields: [skuId], references: [id])
}

model Dispatch {
  id           String   @id @default(cuid())
  code         String   @unique
  ibtId        String?
  storeId      String
  technicianId String
  signedBy     String?
  signatureUrl String?
  dispatchedAt DateTime @default(now())
  receivedAt   DateTime?

  ibt        Ibt?  @relation(fields: [ibtId], references: [id])
  store      Store @relation(fields: [storeId], references: [id])
  technician User  @relation(fields: [technicianId], references: [id])
}

// ---------- Procurement ----------
model PurchaseRequest {
  id            String   @id @default(cuid())
  code          String   @unique
  requesterId   String
  status        String   @default("DRAFT")
  approverId    String?
  totalEstCents Int      @default(0)
  justification String?
  createdAt     DateTime @default(now())

  requester User  @relation("PrRequester", fields: [requesterId], references: [id])
  approver  User? @relation("PrApprover", fields: [approverId], references: [id])

  lines PurchaseRequestLine[]
  pos   PurchaseOrder[]
}

model PurchaseRequestLine {
  id               String @id @default(cuid())
  prId             String
  skuId            String
  qty              Int
  estUnitCostCents Int

  pr  PurchaseRequest @relation(fields: [prId], references: [id], onDelete: Cascade)
  sku Sku             @relation(fields: [skuId], references: [id])
}

model PurchaseOrder {
  id               String   @id @default(cuid())
  code             String   @unique
  supplierId       String
  prId             String?
  status           String   @default("DRAFT")
  totalCents       Int      @default(0)
  sentAt           DateTime?
  expectedDelivery DateTime?

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  pr       PurchaseRequest? @relation(fields: [prId], references: [id])
}

// ---------- Service ----------
model Repair {
  id           String   @id @default(cuid())
  code         String   @unique
  assetId      String
  status       String   @default("LOGGED")
  faultDesc    String
  supplierId   String?
  sentAt       DateTime?
  receivedAt   DateTime?
  costCents    Int      @default(0)
  warrantyClaim Boolean @default(false)
  outcome      String?
  createdAt    DateTime @default(now())

  asset    Asset     @relation(fields: [assetId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
}

model Invoice {
  id              String   @id @default(cuid())
  docNo           String
  supplierId      String
  invoiceDate     DateTime
  totalCents      Int      @default(0)
  fileUrl         String?
  ocrText         String?
  linkedAssetId   String?
  linkedGrvId     String?
  linkedPoId      String?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  linkedGrv Grv?    @relation(fields: [linkedGrvId], references: [id])
}

// ---------- Audit ----------
model Audit {
  id           String   @id @default(cuid())
  code         String   @unique
  storeId      String
  scheduledFor DateTime
  status       String   @default("SCHEDULED")
  conductedById String?
  completedAt  DateTime?

  store Store @relation(fields: [storeId], references: [id])
  lines AuditLine[]
}

model AuditLine {
  id        String  @id @default(cuid())
  auditId   String
  assetId   String?
  expected  Boolean
  found     Boolean
  condition String?
  variance  String? // MISSING, DAMAGED, UNRECORDED
  photoUrl  String?
  notes     String?

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String   @id @default(cuid())
  type        String
  severity    String   @default("INFO")
  refTable    String?
  refId       String?
  message     String
  createdAt   DateTime @default(now())
  dismissedAt DateTime?
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  method     String?
  path       String?
  payload    String?
  occurredAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([occurredAt])
}

// ---------- Software & License Management ----------
model SoftwareTitle {
  id           String   @id @default(cuid())
  name         String
  vendor       String
  type         String   @default("PERPETUAL") // PERPETUAL | SUBSCRIPTION | SAAS | OEM
  notes        String?
  createdAt    DateTime @default(now())
  licenses     SoftwareLicense[]

  @@unique([name, vendor])
}

model SoftwareLicense {
  id              String   @id @default(cuid())
  titleId         String
  licenseKeyMask  String?  // last-4 only is stored on display; encrypted full key not in scope
  licenseKey      String?  // raw key; consider encrypting at app layer if sensitive
  seatsTotal      Int      @default(1)
  costCents       Int      @default(0)
  purchaseDate    DateTime?
  expiryDate      DateTime?
  supplierId      String?
  notes           String?
  createdAt       DateTime @default(now())

  title       SoftwareTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  assignments SoftwareAssignment[]
}

model SoftwareAssignment {
  id          String   @id @default(cuid())
  licenseId   String
  userId      String?
  assetId     String?
  assignedAt  DateTime @default(now())
  revokedAt   DateTime?
  notes       String?

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
}

// ---------- Store backups ----------
// One PC per store (till or back-office). Auto-created by the agent's first check-in.
model StorePc {
  id                String   @id @default(cuid())
  storeId           String?                        // null for HQ-scoped PCs
  departmentId      String?                        // set for HQ PCs
  scope             String   @default("STORE")     // STORE | HQ
  name              String                     // e.g. "POS1", "POS2", "BackOffice", "HR-Laptop-01"
  role              String   @default("TILL")  // TILL | BACKOFFICE | HQ
  backupPaths       String   @default("[]")    // JSON array of paths on the PC
  isActive          Boolean  @default(true)
  lastBackupAt      DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  // Agent enrollment metadata (populated by the PC installer)
  agentInstalledAt  DateTime?
  agentVersion      String?
  osVersion         String?
  osBuild           String?
  cpuModel          String?
  ramGb             Int?
  ipAddress         String?
  lastInventoryAt   DateTime?
  apiKeyId          String?                    // back-reference to per-PC ApiKey
  assetId           String?                    // linked Asset row in the register

  store Store?      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  runs  BackupRun[]

  @@unique([storeId, name])
  @@unique([departmentId, name])
  @@index([storeId])
  @@index([departmentId])
}

// One config per store — created automatically when a store is created.
model BackupJob {
  id             String   @id @default(cuid())
  storeId        String   @unique
  scheduleCron   String   @default("0 2 * * *") // daily at 02:00 local
  retentionDays  Int      @default(30)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model BackupRun {
  id          String   @id @default(cuid())
  pcId        String
  status      String   @default("RUNNING") // RUNNING | SUCCESS | FAILED
  startedAt   DateTime @default(now())
  completedAt DateTime?
  sizeBytes   BigInt   @default(0)
  storagePath String?
  error       String?
  sourceIp    String?

  pc StorePc @relation(fields: [pcId], references: [id], onDelete: Cascade)

  @@index([pcId, startedAt])
}

model Decommission {
  id                String   @id @default(cuid())
  assetId           String   @unique
  reason            String   // OBSOLETE | FAULTY | LOST | SOLD | OTHER
  notes             String?
  dataWipeCertUrl   String?
  disposalSlipUrl   String?
  disposalVendor    String?
  disposedAt        DateTime @default(now())
  signedOffById     String?
}

model DepreciationRun {
  id                     String   @id @default(cuid())
  period                 String   // YYYY-MM
  postedAt               DateTime @default(now())
  totalDepreciationCents Int      @default(0)
}

// ---------- Toner dispatching ----------
model TonerType {
  id            String   @id @default(cuid())
  code          String   @unique          // 111L, 154A, 737, 285A
  name          String                    // "HP 111L Original Toner Cartridge"
  manufacturer  String   @default("HP")
  unitCostCents Int      @default(0)      // ex VAT, in cents
  vatPct        Int      @default(15)
  hqStock       Int      @default(0)      // HQ on-hand
  reorderLevel  Int      @default(0)
  isActive      Boolean  @default(true)

  plans       TonerPlan[]
  orderLines  TonerOrderLine[]
}

model TonerPlan {
  id           String  @id @default(cuid())
  storeId      String
  tonerTypeId  String
  year         Int
  jan Int @default(0)
  feb Int @default(0)
  mar Int @default(0)
  apr Int @default(0)
  may Int @default(0)
  jun Int @default(0)
  jul Int @default(0)
  aug Int @default(0)
  sep Int @default(0)
  oct Int @default(0)
  nov Int @default(0)
  dec Int @default(0)

  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tonerType  TonerType @relation(fields: [tonerTypeId], references: [id], onDelete: Cascade)

  @@unique([storeId, tonerTypeId, year])
}

model TonerOrder {
  id        String   @id @default(cuid())
  code      String   @unique         // TON-2026-06
  period    String                   // YYYY-MM
  status    String   @default("DRAFT")  // DRAFT | DISPATCHED | RECEIVED | CLOSED | CANCELLED
  notes     String?
  createdAt DateTime @default(now())
  closedAt  DateTime?

  lines     TonerOrderLine[]
}

model TonerOrderLine {
  id            String    @id @default(cuid())
  orderId       String
  storeId       String
  tonerTypeId   String
  plannedQty    Int       @default(0)
  dispatchedQty Int       @default(0)
  receivedQty   Int       @default(0)
  courier       String?
  trackingNo    String?
  boxNumbers    String?
  dispatchedAt  DateTime?
  receivedAt    DateTime?
  signedBy      String?
  signatureUrl  String?

  order      TonerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store      Store      @relation(fields: [storeId], references: [id])
  tonerType  TonerType  @relation(fields: [tonerTypeId], references: [id])

  @@unique([orderId, storeId, tonerTypeId])
}

model HelpdeskLink {
  id               String    @id @default(cuid())
  ticketExternalId String
  system           String    // FRESHSERVICE | JIRA_SM | STUB
  summary          String
  openedAt         DateTime
  closedAt         DateTime?
  assetId          String?
  createdAt        DateTime  @default(now())

  @@unique([system, ticketExternalId])
  @@index([assetId])
}

// ---------- API keys for external scripts (Kaseya VSA discovery agent) ----------
model ApiKey {
  id          String    @id @default(cuid())
  label       String    // human-readable, e.g. "Kaseya VSA discovery"
  keyHash     String    @unique // sha256 of the raw key
  prefix      String    // first 8 chars of the raw key, for UI display
  scope       String    @default("DISCOVERY") // DISCOVERY | BACKUP | AGENT | FULL
  storeId     String?                          // if set, key is bound to this store
  pcId        String?                          // if set, key is bound to a single PC (per-agent)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
}

// ---------- Store PC agent enrollment ----------
// A store-scoped one-shot (or few-shot) code an admin generates and pastes into
// the installer. The installer redeems it once to get a per-PC agent key and
// register the PC under the correct store.
model EnrollmentToken {
  id            String    @id @default(cuid())
  token         String    @unique                 // opaque; short, human-friendly (12 chars)
  scope         String    @default("STORE")       // STORE | HQ
  storeId       String?                            // set when scope=STORE
  departmentId  String?                            // set when scope=HQ
  usesRemaining Int       @default(5)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  revokedAt     DateTime?
  lastUsedAt    DateTime?

  @@index([storeId])
  @@index([departmentId])
}

// ---------- Per-user store access (used by DVRs and other store-scoped views) ----------
// Grant an Area Manager / Auditor / Loss-Prevention person visibility to
// specific stores only. Anyone with the DvrsReadAll permission (typically
// Administrator + IT Manager) bypasses this and sees everything.
model UserStoreAccess {
  userId    String
  storeId   String
  grantedAt DateTime @default(now())
  grantedBy String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

// ---------- CCTV DVRs (Dahua / Hikvision) ----------
// One row per DVR at a store. Credentials are stored in plain text so the
// snapshot proxy can talk to the device; reads are gated by dvrs:read and
// only the snapshot/web-launch endpoints ever expose them further.
model Dvr {
  id          String    @id @default(cuid())
  storeId     String
  name        String                              // "Front cameras", "Back office", etc.
  brand       String                              // DAHUA | HIKVISION | OTHER
  model       String?
  serialNo    String?
  ipAddress   String                              // reachable via store WireGuard/SSTP tunnel
  httpPort    Int       @default(80)
  rtspPort    Int       @default(554)
  channels    Int       @default(4)
  username    String    @default("admin")
  password    String                              // required to fetch snapshots
  notes       String?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([brand])
}

// ---------- Nedbank Verifone PIN pads ----------
// Auto-detected via USB VID_11CA on each till's inventory push. One row per
// physical device (unique by serial). We keep last-known assignment
// (store + till) plus a full movement log so we can prove a device was at a
// given store between dates if Nedbank ever asks.
model PinPad {
  id                    String    @id @default(cuid())
  serialNo              String    @unique         // from USB descriptor
  model                 String?                    // VX520, P400, V200c, etc — parsed from USB PID or a lookup
  manufacturer          String    @default("Verifone")
  productId             String?                    // e.g. "0x0207"
  usbDeviceId           String?                    // full Windows PnP DeviceID for forensics

  currentPcId           String?                    // last-known till PC
  currentStoreId        String?                    // last-known store
  currentPcName         String?                    // denormalized for reports even if PC record is deleted
  currentStoreCode      String?                    // denormalized for CSV export

  status                String    @default("DETECTED") // DETECTED | ASSIGNED | RETURNED | MISSING | UNKNOWN
  firstDetectedAt       DateTime  @default(now())
  lastDetectedAt        DateTime  @default(now())
  markedMissingAt       DateTime?

  receivedFromNedbankAt DateTime?
  receivedRef           String?                    // Nedbank delivery note / invoice
  returnedToNedbankAt   DateTime?
  returnRef             String?                    // Nedbank return reference

  notes                 String?

  events                PinPadEvent[]

  @@index([currentStoreId])
  @@index([currentPcId])
  @@index([status])
}

// Every change in location (new PC, new store, disappearance, return) writes
// one row. Enough to reconstruct the full history for auditing / Nedbank
// disputes.
model PinPadEvent {
  id          String   @id @default(cuid())
  pinPadId    String
  eventType   String                                // DETECTED | MOVED_PC | MOVED_STORE | MARKED_MISSING | RETURNED | ASSIGNED | NOTES
  occurredAt  DateTime @default(now())
  fromPcId    String?
  fromStoreId String?
  toPcId      String?
  toStoreId   String?
  fromPcName    String?
  fromStoreCode String?
  toPcName      String?
  toStoreCode   String?
  actorUserId String?                                // user who made the change (null for agent-triggered)
  notes       String?

  pinPad PinPad @relation(fields: [pinPadId], references: [id], onDelete: Cascade)

  @@index([pinPadId, occurredAt])
}

// Raw software inventory pushed by the PC agent. Full-replace snapshot per PC
// on each successful report -- old rows for that pcId are deleted first.
model PcSoftwareEntry {
  id          String    @id @default(cuid())
  pcId        String
  name        String
  version     String?
  publisher   String?
  installDate DateTime?
  source      String    @default("REGISTRY")     // REGISTRY | APPX
  reportedAt  DateTime  @default(now())

  @@index([pcId])
  @@index([pcId, name])
}

model DiscoveryReport {
  id           String   @id @default(cuid())
  assetId      String?
  hostname     String
  manufacturer String?
  model        String?
  serialNo     String?
  osVersion    String?
  cpuModel     String?
  ramGb        Int?
  macAddresses String?
  payload      String?  // raw JSON for forensic analysis
  reportedAt   DateTime @default(now())
  sourceIp     String?
}

// ---------- MikroTik store-router config generator ----------
// One row per brand — tracks the last third-octet handed out so the next
// store gets the next network. Each new network is a /23 on the brand's
// /16 (10.168 for FF, 10.167 for EV, 10.166 for MB).
model MikrotikNetworkPool {
  brand          String   @id                 // FASHION_FUSION | EVOLVE | MY_BRANDS
  displayName    String                        // "Fashion Fusion"
  identityPrefix String                        // "FF" | "EV" | "MB"
  ipPrefix       String                        // "10.168"
  cidr           Int      @default(23)
  lastThirdOctet Int                           // last third-octet allocated (0-255)
  updatedAt      DateTime @updatedAt
}

// Full history of every generated router config, so we can re-download or audit.
model MikrotikConfig {
  id                String   @id @default(cuid())
  brand             String                       // FASHION_FUSION | EVOLVE | MY_BRANDS
  siteCode          String                       // "Empangeni", "WonderparkMall"
  identity          String                       // "FF-Empangeni-GW"
  storeId           String?                      // optional link to a Store
  thirdOctet        Int                          // the octet we consumed
  lanGateway        String                       // "10.168.117.1"
  lanNetwork        String                       // "10.168.116.0"
  cidr              Int      @default(23)
  dhcpRangeStart    String
  dhcpRangeEnd      String
  wan1Type          String   @default("DHCP")    // DHCP | PPPOE
  wan1Iface         String   @default("ether1-WAN1")
  wan1PppoeUser     String?
  wan1PppoePassword String?
  wan2Type          String   @default("DHCP")
  wan2Iface         String   @default("ether5-WAN2")
  wan2PppoeUser     String?
  wan2PppoePassword String?
  ssid              String
  wpaPsk            String
  wgListenPort      Int
  wgHubPublicKey    String
  wgHubEndpoint     String
  wgHubEndpointPort Int      @default(443)
  wgTunnelIp        String   @default("")        // "172.31.254.x/32" — allocated by hub team, filled in later
  remoteWinboxBlock String                       // pasted by user; embedded verbatim
  configText        String                       @db.Text
  createdAt         DateTime @default(now())
  createdById       String?
}
