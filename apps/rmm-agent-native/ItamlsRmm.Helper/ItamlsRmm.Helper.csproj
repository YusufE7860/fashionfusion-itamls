<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>itamls-rmm-helper</AssemblyName>
    <RootNamespace>ItamlsRmm.Helper</RootNamespace>
    <Version>2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Helper runs with elevated privileges in the user session but does
         NOT need a UI itself — it's a background process spawned by the
         service. Still a WinExe so there's no console window flash. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Vortice — DXGI + Direct3D11 bindings for hardware screen capture.
         Successor to SharpDX (archived). Managed wrappers, no native DLL
         to ship — DX is already on every Windows box. -->
    <PackageReference Include="Vortice.DXGI"          Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11"    Version="3.6.2" />
    <!-- NAudio — WASAPI loopback for "what's playing out of the speakers". -->
    <PackageReference Include="NAudio"                Version="2.2.1" />
  </ItemGroup>
</Project>
