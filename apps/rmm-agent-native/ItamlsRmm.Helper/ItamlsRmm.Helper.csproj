<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Must be Exe (not WinExe). WinExe + PublishSingleFile + spawned via
         CreateProcessAsUser silently fails to initialize - the single-file
         host needs a console subsystem to extract correctly in that path.
         CREATE_NO_WINDOW in the service spawn still suppresses any console
         window from flashing in production. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NOT single-file. Single-file self-extracting apps fail silently when
         the apphost is launched via CreateProcessAsUser with an unelevated
         user token after an earlier elevated run populated the extract dir
         with files the user can't read. We publish as a folder of DLLs so
         there's no extract step and no cross-integrity file access issue. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>itamls-rmm-helper</AssemblyName>
    <RootNamespace>ItamlsRmm.Helper</RootNamespace>
    <Version>2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Helper runs with elevated privileges in the user session but does
         NOT need a UI itself — it's a background process spawned by the
         service. Still a WinExe so there's no console window flash. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Vortice — DXGI + Direct3D11 bindings for hardware screen capture.
         Successor to SharpDX (archived). Managed wrappers, no native DLL
         to ship — DX is already on every Windows box. -->
    <PackageReference Include="Vortice.DXGI"          Version="3.6.2" />
    <PackageReference Include="Vortice.Direct3D11"    Version="3.6.2" />
    <!-- NAudio — WASAPI loopback for "what's playing out of the speakers". -->
    <PackageReference Include="NAudio"                Version="2.2.1" />
  </ItemGroup>
</Project>
